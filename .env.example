# === HH.ru API ===
# Публичный поиск вакансий не требует токена, но hh.ru требует явный User-Agent.
# OAuth-приложение нужно только если требуется доступ к приватным данным (резюме, отклики и т.п.)
# Регистрация приложения: https://dev.hh.ru/admin
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=
HH_USER_AGENT=hh-parser-bot/1.0 (your-email@example.com)
# Прокси для запросов к hh.ru (socks5://… или http://…). На главном узле —
# SOCKS RU-ноды: socks5://17.9.7.5:1080. Пусто — напрямую. Через него же ходит
# и Хабр Карьера.
HH_PROXY_URL=

# === Хабр Карьера (career.habr.com) ===
# Второй источник вакансий, ищет по тем же пресетам. false — только hh.ru.
HABR_ENABLED=true

# === Отклики (только владелец бота) ===
# Telegram id владельца: ему под вакансиями кнопки «✅ Подтвердить / ❌ Отклонить»
# и пункт меню «⚙️ Отклики». 0 или пусто — отклики выключены.
OWNER_TELEGRAM_ID=
# Ключ шифрования cookies в БД (Fernet). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Сменили ключ — сохранённые входы не расшифровать, подключать заново.
SESSION_ENCRYPTION_KEY=
# User-Agent запросов от имени владельца (по умолчанию — Chrome под Windows).
# BROWSER_USER_AGENT=

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Прокси к Telegram API — только там, где он заблокирован (локально в
# docker-compose.yml задан socks5://warp:1080). На главном узле не нужен.
TELEGRAM_PROXY_URL=

# === Database ===
DATABASE_URL=postgresql+asyncpg://hh:hh@db:5432/hh_pars
POSTGRES_USER=hh
POSTGRES_PASSWORD=hh
POSTGRES_DB=hh_pars

# === Parser settings ===
PARSE_INTERVAL_MINUTES=30
HH_SEARCH_TEXT=python developer
HH_SEARCH_AREA=1
LOG_LEVEL=INFO

# === Только сервер (docker-compose.prod.yml) ===
# Какой образ запускать; deploy.sh переписывает строку при каждом деплое.
# HH_PARS_IMAGE=ghcr.io/ggwolst/hh-pars:latest
# Чтобы `docker compose` в каталоге приложения брал боевой файл без -f:
# COMPOSE_FILE=docker-compose.prod.yml
